# Production Environment Configuration
# Copy this file to .env.production and fill in your production values
# NEVER commit actual production secrets to version control

# Server
PORT=5000
NODE_ENV=production

# Database (use production MongoDB URI)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cpms?appName=CPMS

# JWT Secrets (MUST be at least 32 characters, generate new ones for production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=<generate-strong-64-char-hex-secret>
JWT_REFRESH_SECRET=<generate-different-strong-64-char-hex-secret>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URL (HTTPS only in production, comma-separated for multiple)
FRONTEND_URL=https://yourdomain.com

# Redis (use managed Redis like Redis Cloud, AWS ElastiCache, etc.)
REDIS_URL=redis://<redis-host>:6379

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Email (Brevo/Sendinblue for transactional emails)
BREVO_API_KEY=<your-brevo-api-key>
BREVO_SENDER_EMAIL=<verified-sender@yourdomain.com>

# Admin email for seeding (optional)
ADMIN_EMAIL=admin@yourdomain.com
